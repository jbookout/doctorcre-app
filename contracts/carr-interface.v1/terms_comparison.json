{
  "schema_version": "terms-comparison.v1",
  "producer": {
    "repository": "DoctorCRE/carr-system",
    "source_commit": "7a4baa048e778854a8a66402fae5b7dc2657847c",
    "pull_request": "https://github.com/DoctorCRE/carr-system/pull/2760"
  },
  "prepare": {
    "verb": "prepare-terms-comparison",
    "route": "/api/v1/fact-review/comparison",
    "method": "POST",
    "input": [
      "idempotency_key",
      "deal_id",
      "fields"
    ],
    "field": [
      "fact_key",
      "prior_version",
      "current_version"
    ],
    "output": [
      "ok",
      "schema_version",
      "document_id",
      "template",
      "basename",
      "deal",
      "status",
      "owed",
      "partial",
      "carried",
      "edits",
      "remaining",
      "human_gate"
    ]
  },
  "validate": {
    "verb": "validate-terms-comparison",
    "route": "/api/v1/fact-review/comparison/validate",
    "input": [
      "document_id"
    ],
    "schema_version": "terms-comparison-validation.v1"
  },
  "http_refusal": {
    "status": 400,
    "error": "comparison_fact_blocked",
    "fields": [
      "field",
      "reason"
    ],
    "reasons": [
      "missing",
      "unresolved",
      "stale_snapshot",
      "missing_version",
      "source_not_permitted",
      "invalid_value"
    ]
  },
  "display": "Read-only LOI Grid fill plan. Only edits contain permitted display values and source labels. No document paths, ids or internal lineage are displayed.",
  "versions": "Reference fields with confirmed prior and current versions. Use current canonical_version and the greatest confirmed canonical_history version below it. Other fields are named as remaining work and do not block comparable fields."
}
