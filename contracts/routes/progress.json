{
  "routes": [
    {
      "path": "/control-room/progress",
      "asset": "progress-board.html",
      "order": 2,
      "gatePath": "/control-room"
    },
    {
      "path": "/control-room/progress/board/:boardId",
      "asset": "progress-board.html",
      "order": 2.1,
      "gatePath": "/control-room"
    }
  ],
  "redirects": [
    {
      "path": "/progress-board",
      "to": "/control-room/progress",
      "order": 0
    }
  ]
}
