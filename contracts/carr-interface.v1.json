          "degraded",
          "failed",
          "unknown",
          "disabled",
          "not-yet-operational"
        ],
        "capability_stages": [
          "act",
          "draft",
          "read",
          "unavailable"
        ],
        "owner_keys": [
          "kind",
          "ref"
        ],
        "workflow_truth": {
          "unavailable_keys": [
            "available",
            "source",
            "reason"
          ],
          "available_keys": [
            "available",
            "source",
            "state",
            "enabled",
            "admissible_modes"
          ],
          "states": [
            "unknown",
            "conflict",
            "undeclared",
            "unregistered",
            "declared_disabled",
            "enabled_shadow_only",
            "enabled_canary_eligible",
            "enabled_live_eligible",
            "operational"
          ]
        },
        "evidence_states": [
          "unreadable",
          "missing",
          "mismatched",
          "unbindable",
          "conflicting",
          "refused_substitute",
          "failed",
          "error",
          "skipped",
          "untested",
          "self_attested",
          "indistinct",
          "stale",
          "passing"
        ],
        "evidence_statuses": [
          "pass",
          "fail",
          "skipped",
          "untested",
          "error",
          "conflicting"
        ],
        "absent_evidence_keys": [
          "layer",
          "state",
          "present",
          "scope"
        ],
        "present_evidence_keys": [
          "layer",
          "state",
          "present",
          "status",
          "basis",
          "scope",
          "subject_ref",
          "evaluator_ref",
          "evidence_ref",
          "evidence_digest",
          "observed_at",
          "expires_at",
          "incident_refs",
          "recovery_refs"
        ],
