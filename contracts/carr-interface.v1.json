{
  "schema": "doctorcre-carr-interface.v1",
  "version": "1.10.0",
  "producer": {
    "repository": "jbookout/carr-system",
    "source_commit": "69df0ae6cfeef5caada6104f66a98c60a5bda709"
  },
  "consumer": "jbookout/doctorcre-app",
  "transport": {
    "origin": "same-origin",
    "edge_transport": "private Cloudflare Worker service binding",
    "authentication": "server-issued host-only session",
    "writes": "MCP JSON-RPC tools/call with idempotency keys",
    "database_access": "forbidden"
  },
  "mcp_operations": [
    "acknowledge-notification",
    "add-critical-date",
    "add-deal-note",
    "add-loop",
    "capture-queue",
    "close-loop",
    "create-national-account",
    "create-national-market-deal",
    "current-work-item",
    "current-work-requests",
    "deal-room-board",
    "decline-work-request",
    "end-deal-review",
    "engineering-passport",
    "get-call-context",
    "get-deal-room",
    "get-incident",
    "incident-board",
    "link-incident-work-request",
    "loop-board",
    "loop-headers",
    "new-deal",
    "notification-feed",
    "patch-deal-field",
    "presence-lease",
    "read-loop",
    "read-portfolio",
    "resolve-candidate",
    "resolve-conflict",
    "resolve-post-call-candidate",
    "revert-deal-field",
    "review-deal",
    "set-lead",
    "set-market-agent",
    "set-national-account-owner",
    "set-next-step",
    "set-work-shape-disposition",
    "start-deal-review",
    "supersede-work-request",
    "update-deal",
    "update-loop",
    "work-request-card"
  ],
  "http_surfaces": [
    "/pipeline/changes",
    "/api/v1/business/*",
    "/api/v1/command-center",
    "/api/v1/work-inventory",
    "/api/room/*",
    "/api/system-work/*",
    "/api/share/*",
    "/api/tours/*"
  ],
  "invariants": [
    "The browser never receives database credentials.",
    "The browser never selects its actor, tenant, sponsor, or authority class.",
    "A refused write and an unanswered write remain distinct states.",
    "Retries reuse the same idempotency key and reconcile against CARR.",
    "Fixture data is synthetic and cannot become production state.",
    "One logical operation carries one idempotency key across double click, reconnect and a second device; a re-send under that key replays the stored answer instead of writing again.",
    "The sentence a partner types is sent verbatim as human_quote, or not at all; the app never composes one."
  ]
}
