  "invariants": [
    "The browser never receives database credentials.",
    "The browser never selects its actor, tenant, sponsor, or authority class.",
    "A refused write and an unanswered write remain distinct states.",
    "Retries reuse the same idempotency key and reconcile against CARR.",
    "Fixture data is synthetic and cannot become production state.",
    "One logical operation carries one idempotency key across double click, reconnect and a second device; a re-send under that key replays the stored answer instead of writing again.",
    "The sentence a partner types is sent verbatim as human_quote, or not at all; the app never composes one.",
    "Property evidence v1 is a read-only, tenant-bound response; every fact carries its own source and temporal review state, and absent authoritative coverage remains unknown or unavailable."
  ],
  "mcp_read_contracts": {
    "correspondence-readiness": {
      "write": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "response": {
        "schema_version": "doctorcre-v5-j103-correspondence-store.v1",
        "required_keys": [
          "ok",
          "schema_version",
          "readiness",
          "mailbox_reads_possible",
          "activation",
          "owed",
          "kernel_gaps",
          "policy",
          "consentable_operations",
          "never_consentable_operations",
          "dispatchable",
          "provider_operation",
          "send_authority_holder",
          "send_authority_seam",
          "automatic_internal_update",
          "effects"
        ],
        "readiness_keys": [
          "server_instant",
          "partners",
          "read_receipt_writer_granted_to_runtime"
        ],
        "partner_keys": [
          "partner_slug",
          "consents_in_force",
          "consents_revoked",
          "read_receipts",
          "drafts"
        ],
        "evidence_coverage": "Installation counts only; no deal or meeting index."
      }
    },
    "read-correspondence-thread": {
      "write": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_system": {
            "type": "string"
          },
          "native_id": {
            "type": "string"
          },
          "native_id_epoch": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "source_system",
          "native_id",
          "native_id_epoch"
        ]
      },
      "response": {
        "required_keys": [
          "ok",
          "decision",
          "reason_id",
          "native_identity",
          "receipts",
          "dispatchable",
          "provider_operation",
          "send_authority_holder",
          "send_authority_seam",
          "automatic_internal_update",
          "effects"
        ],
        "decisions": {
          "unavailable": {
            "additional_required_keys": [
              "owed_seam"
            ],
            "receipts": []
          },
          "receipts_found": {
            "receipt_keys": [
              "read_receipt_id",
              "partner_slug",
              "adapter_kind",
              "account_digest",
              "native_identity",
              "thread_metadata",
              "metadata_digest",
              "consent_in_force",
              "recorded_at"
            ]
          }
        },
        "thread_metadata": "Opaque JSON object. Store enforces related relevance, forbids raw content and returns metadata only; no subject/body/attachment bytes.",
        "identity_source": "Use only native identity already recorded on the deal activity; this verb does not discover threads by deal."
      }
    },
    "read-assurance-health": {
      "write": false,
      "producer": {
        "repository": "jbookout/carr-system",
        "source_commit": "72bac3e9abc09a5a8e908cefeae0e692c9ec73a5",
        "module": "mcp-server/src/assurance-health-store.v5.js",
        "projection_source": "migrations/0717_assurance_health_evidence_store.sql"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "workflow_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "workflow_version": {
                "type": "integer",
                "minimum": 1
              },
              "work_request_id": {
                "type": "string",
                "pattern": "^WR-[0-9]{1,12}$"
              }
            },
            "required": [
              "workflow_key",
              "workflow_version"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "response": {
        "schema_version": "assurance-health.v1",
        "required_keys": [
          "schema_version",
          "scope",
          "state",
          "green",
          "state_reason",
          "capability_stage",
          "capability_stage_attributable_to_findings",
          "workflow_truth",
          "owner",
          "evidence",
          "failing_layers",
          "indeterminate_layers",
          "missing_layers",
          "unbindable_layers",
          "reasons",
          "impact",
          "recovery"
        ],
        "states": [
