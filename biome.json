{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**/*.{ts,tsx,mts,cts}",
      "!reports/vendor/maplibre-gl-6.4.1/maplibre-gl.mjs",
      "!reports/vendor/maplibre-gl-6.4.1/maplibre-gl-shared.mjs",
      "!reports/vendor/maplibre-gl-6.4.1/maplibre-gl-worker.mjs",
      "!tours/vendor/maplibre-gl-6.4.1/maplibre-gl.mjs",
      "!tours/vendor/maplibre-gl-6.4.1/maplibre-gl-shared.mjs",
      "!tours/vendor/maplibre-gl-6.4.1/maplibre-gl-worker.mjs"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "noInferrableTypes": "error"
      }
    }
  }
}
