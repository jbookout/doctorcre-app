{
  "name": "doctorcre-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "scripts": {
    "build": "node scripts/build-artifact.mjs build",
    "artifact:verify": "node scripts/build-artifact.mjs verify",
    "check": "tsc --noEmit -p tsconfig.json && node scripts/check-repository.mjs",
    "deployment:check": "npm run deployment:check:staging && npm run deployment:check:production",
    "deployment:check:staging": "wrangler versions upload --env staging --strict --dry-run --var GIT_SHA:0000000000000000000000000000000000000000",
    "deployment:check:production": "wrangler versions upload --env \"\" --strict --dry-run --var GIT_SHA:0000000000000000000000000000000000000000",
    "dev:staging": "npm run build && wrangler dev --env staging",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:staging": "node scripts/release-staging.mjs",
    "rollback:staging": "node scripts/rollback-staging.mjs",
    "release:production": "node scripts/release-production.mjs",
    "rollback:production": "node scripts/rollback-production.mjs",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "privacy:check": "node scripts/privacy/client-data-check.mjs",
    "privacy:fixtures": "node scripts/privacy/generate-synthetic-fixtures.mjs",
    "test:regressions": "e2e run --config e2e.regressions.config.ts",
    "performance:measure": "node scripts/measure-performance.mjs",
    "performance:check": "npm run performance:measure && node scripts/performance-budget.mjs contracts/performance-budget.v1.json test-artifacts/performance/report.json test-artifacts/performance/summary.md",
    "pretest": "node scripts/prepare-offline-tour.mjs",
    "prebuild": "node scripts/prepare-offline-tour.mjs",
    "preserve": "node scripts/prepare-offline-tour.mjs",
    "predeployment:check:staging": "node scripts/prepare-offline-tour.mjs",
    "predeployment:check:production": "node scripts/prepare-offline-tour.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/typesafe-ai": "^3.0.20",
    "@e2e-dev/decision": "^0.2.3",
    "@e2e-dev/web": "^0.15.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "^7.0.142",
    "axe-core": "4.14.0",
    "e2e": "^0.21.1",
    "es-module-lexer": "1.7.0",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "jsdom": "^26.1.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tar-stream": "3.2.2",
    "typescript": "7.0.2",
    "wrangler": "4.131.2"
  }
}
