{
  "name": "DoctorCRE Workspace",
  "short_name": "DoctorCRE",
  "description": "Joe and Dell's shared CRE workspace",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#111419",
  "theme_color": "#111419",
  "lang": "en",
  "share_target": {
    "action": "/share-to-deal",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic",
            ".heif",
            "application/pdf",
            "image/jpeg",
            "image/png",
            "image/heic",
            "image/heif"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icons/dealroom-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/dealroom-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
