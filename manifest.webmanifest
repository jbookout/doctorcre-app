{
  "name": "DoctorCRE Workspace",
  "short_name": "DoctorCRE",
  "description": "Joe and Dell's shared CRE workspace",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#111419",
  "theme_color": "#111419",
  "lang": "en",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic"
          ]
        }
      ]
    }
  }
}
