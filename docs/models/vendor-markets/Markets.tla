---- MODULE Markets ----
\* Generated by chart-to-tla.mjs from markets.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart markets.mmd keeps it, checks it, and compares it with the chart.

VARIABLES view, selection, read, session
vars == <<view, selection, read, session>>

\* Region View
viewStates == {"Category", "Market"}
\* Region Selection
selectionStates == {"Canonical", "Unselected"}
\* Region Read
readStates == {"Empty", "Idle", "Loading", "Ready", "Unavailable"}
\* Region Session
sessionStates == {"Active", "Retired"}

TypeOK ==
    /\ view \in viewStates
    /\ selection \in selectionStates
    /\ read \in readStates
    /\ session \in sessionStates

Init ==
    /\ view = "Category"
    /\ selection = "Unselected"
    /\ read = "Idle"
    /\ session = "Active"

\* open Market
OpenMarket ==
    /\ session = "Active" \* src/ui/vendor-markets.tsx dispose removes the view
    /\ (view \in {"Category"} \/ read \in {"Idle"})
    /\ \/ (view = "Category" /\ view' = "Market")
       \/ (view \notin {"Category"} /\ UNCHANGED view)
    /\ \/ (read = "Idle" /\ read' = "Loading")
       \/ (read \notin {"Idle"} /\ UNCHANGED read)
    /\ UNCHANGED <<selection, session>>

\* open Category
OpenCategory ==
    /\ session = "Active" \* src/ui/vendor-markets.tsx dispose removes the view
    /\ \/ (view = "Market" /\ view' = "Category")
    /\ UNCHANGED <<selection, read, session>>

\* refresh
Refresh ==
    /\ session = "Active" \* src/ui/vendor-markets.tsx dispose removes the view
    /\ (view \in {"Market"} \/ selection \in {"Canonical"} \/ read \in {"Ready", "Empty", "Unavailable"})
    /\ \/ (view = "Market" /\ view' = "Market")
       \/ (view \notin {"Market"} /\ UNCHANGED view)
    /\ \/ (selection = "Canonical" /\ selection' = "Canonical")
       \/ (selection \notin {"Canonical"} /\ UNCHANGED selection)
    /\ \/ (read = "Ready" /\ read' = "Loading")
       \/ (read = "Empty" /\ read' = "Loading")
       \/ (read = "Unavailable" /\ read' = "Loading")
       \/ (read \notin {"Ready", "Empty", "Unavailable"} /\ UNCHANGED read)
    /\ UNCHANGED <<session>>

\* producer resolves selection
ProducerResolvesSelection ==
    /\ read = "Loading" \* src/ui/vendor-markets.tsx effect fences late responses
    /\ session = "Active" \* src/ui/vendor-markets.tsx dispose removes the view
    /\ (selection \in {"Unselected"} \/ read \in {"Loading"})
    /\ \/ (selection = "Unselected" /\ selection' = "Canonical")
       \/ (selection \notin {"Unselected"} /\ UNCHANGED selection)
    /\ \/ (read = "Loading" /\ read' = "Ready")
       \/ (read \notin {"Loading"} /\ UNCHANGED read)
    /\ UNCHANGED <<view, session>>

\* select market
SelectMarket ==
    /\ read = "Ready"
    /\ session = "Active" \* src/ui/vendor-markets.tsx dispose removes the view
    /\ (selection \in {"Canonical"} \/ read \in {"Ready"})
    /\ \/ (selection = "Canonical" /\ selection' = "Canonical")
       \/ (selection \notin {"Canonical"} /\ UNCHANGED selection)
    /\ \/ (read = "Ready" /\ read' = "Loading")
       \/ (read \notin {"Ready"} /\ UNCHANGED read)
    /\ UNCHANGED <<view, session>>

\* registry empty
RegistryEmpty ==
    /\ read = "Loading" \* src/ui/vendor-markets.tsx effect fences late responses
    /\ session = "Active" \* src/ui/vendor-markets.tsx dispose removes the view
    /\ (selection \in {"Canonical"} \/ read \in {"Loading"})
    /\ \/ (selection = "Canonical" /\ selection' = "Unselected")
       \/ (selection \notin {"Canonical"} /\ UNCHANGED selection)
    /\ \/ (read = "Loading" /\ read' = "Empty")
       \/ (read \notin {"Loading"} /\ UNCHANGED read)
    /\ UNCHANGED <<view, session>>

\* read fails
ReadFails ==
    /\ read = "Loading" \* src/ui/vendor-markets.tsx effect fences late responses
    /\ session = "Active" \* src/ui/vendor-markets.tsx dispose removes the view
    /\ \/ (read = "Loading" /\ read' = "Unavailable")
    /\ UNCHANGED <<view, selection, session>>

\* session ends
SessionEnds ==
    /\ session = "Active"
    /\ session' = "Retired"
    /\ read' = "Idle"
    /\ selection' = "Unselected"
    /\ view' = "Category"

Next == OpenMarket \/ OpenCategory \/ Refresh \/ ProducerResolvesSelection \/ SelectMarket \/ RegistryEmpty \/ ReadFails \/ SessionEnds

Spec == Init /\ [][Next]_vars

\* Empty registry cannot show a selected market.
EmptySelected == ~(read = "Empty" /\ selection = "Canonical")

RetiredClears == session = "Retired" => read = "Idle" /\ selection = "Unselected"

====
