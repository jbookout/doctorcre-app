---- MODULE TourNavigation ----
\* Generated by chart-to-tla.mjs from tour-navigation.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart tour-navigation.mmd keeps it, checks it, and compares it with the chart.

VARIABLES evidence, selection
vars == <<evidence, selection>>

\* Region Evidence
evidenceStates == {"Absent", "Eligible", "Stale", "Unknown"}
\* Region Selection
selectionStates == {"ChosenStop", "FirstStop", "Outbound", "Retired"}

TypeOK ==
    /\ evidence \in evidenceStates
    /\ selection \in selectionStates

Init ==
    /\ evidence = "Unknown"
    /\ selection = "FirstStop"

\* matching reviewed detail arrives
MatchingReviewedDetailArrives ==
    /\ (evidence \in {"Unknown", "Absent", "Stale"} \/ selection \in {"Retired"})
    /\ \/ (evidence = "Unknown" /\ evidence' = "Eligible")
       \/ (evidence = "Absent" /\ evidence' = "Eligible")
       \/ (evidence = "Stale" /\ evidence' = "Eligible")
       \/ (evidence \notin {"Unknown", "Absent", "Stale"} /\ UNCHANGED evidence)
    /\ \/ (selection = "Retired" /\ selection' = "FirstStop")
       \/ (selection \notin {"Retired"} /\ UNCHANGED selection)

\* detail has no evidence
DetailHasNoEvidence ==
    /\ \/ (evidence = "Unknown" /\ evidence' = "Absent")
    /\ UNCHANGED <<selection>>

\* evidence expires
EvidenceExpires ==
    /\ (evidence \in {"Eligible"} \/ selection \in {"Outbound"})
    /\ \/ (evidence = "Eligible" /\ evidence' = "Stale")
       \/ (evidence \notin {"Eligible"} /\ UNCHANGED evidence)
    /\ \/ (selection = "Outbound" /\ selection' = "ChosenStop")
       \/ (selection \notin {"Outbound"} /\ UNCHANGED selection)

\* route replaced
RouteReplaced ==
    /\ (evidence \in {"Eligible"} \/ selection \in {"Outbound", "ChosenStop"})
    /\ \/ (evidence = "Eligible" /\ evidence' = "Absent")
       \/ (evidence \notin {"Eligible"} /\ UNCHANGED evidence)
    /\ \/ (selection = "Outbound" /\ selection' = "FirstStop")
       \/ (selection = "ChosenStop" /\ selection' = "FirstStop")
       \/ (selection \notin {"Outbound", "ChosenStop"} /\ UNCHANGED selection)

\* session ends
SessionEnds ==
    /\ (evidence \in {"Eligible", "Absent", "Stale", "Unknown"} \/ selection \in {"FirstStop", "ChosenStop", "Outbound"})
    /\ \/ (evidence = "Eligible" /\ evidence' = "Unknown")
       \/ (evidence = "Absent" /\ evidence' = "Unknown")
       \/ (evidence = "Stale" /\ evidence' = "Unknown")
       \/ (evidence = "Unknown" /\ evidence' = "Unknown")
       \/ (evidence \notin {"Eligible", "Absent", "Stale", "Unknown"} /\ UNCHANGED evidence)
    /\ \/ (selection = "FirstStop" /\ selection' = "Retired")
       \/ (selection = "ChosenStop" /\ selection' = "Retired")
       \/ (selection = "Outbound" /\ selection' = "Retired")
       \/ (selection \notin {"FirstStop", "ChosenStop", "Outbound"} /\ UNCHANGED selection)

\* select another stop
SelectAnotherStop ==
    /\ \/ (selection = "FirstStop" /\ selection' = "ChosenStop")
    /\ UNCHANGED <<evidence>>

\* tap Navigate
TapNavigate ==
    /\ evidence = "Eligible" \* tours/itinerary-map.js:219,240; src/ui/tour-navigation.ts:37
    /\ \/ (selection = "ChosenStop" /\ selection' = "Outbound")
    /\ UNCHANGED <<evidence>>

\* return with same user and session
ReturnWithSameUserAndSession ==
    /\ \/ (selection = "Outbound" /\ selection' = "ChosenStop")
    /\ UNCHANGED <<evidence>>

Next == MatchingReviewedDetailArrives \/ DetailHasNoEvidence \/ EvidenceExpires \/ RouteReplaced \/ SessionEnds \/ SelectAnotherStop \/ TapNavigate \/ ReturnWithSameUserAndSession

Spec == Init /\ [][Next]_vars

\* Unknown evidence never launches navigation.
NoUnknownNavigation == ~(evidence = "Unknown" /\ selection = "Outbound")

\* Absent evidence never launches navigation.
NoAbsentNavigation == ~(evidence = "Absent" /\ selection = "Outbound")

\* Stale evidence never launches navigation.
NoStaleNavigation == ~(evidence = "Stale" /\ selection = "Outbound")

\* Retired sessions never retain navigation.
NoRetiredNavigation == ~(evidence = "Eligible" /\ selection = "Retired")

