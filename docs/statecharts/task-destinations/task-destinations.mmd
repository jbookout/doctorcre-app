---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Call follow-up selected |<br/>Call follow-up card shown" as s0
  state "Call follow-up selected |<br/>Card outside current<br/>snapshot" as s1
  state "Call follow-up selected |<br/>Opening call follow-up" as s2
  state "Next action selected |<br/>Card outside current<br/>snapshot" as s3
  state "Next action selected |<br/>Next action card shown" as s4
  state "Next action selected |<br/>Opening next action" as s5
  state "No task selected | Task<br/>results" as s6
  [*] --> s6
  s6 --> s5 : Click next action
  s6 --> s2 : Enter call follow-up
  s5 --> s4 : Home returns the selected card
  s5 --> s3 : Home omits the selected card
  s2 --> s0 : Home returns the selected card
  s2 --> s1 : Home omits the selected card
  class s0 works
  class s1 works
  class s2 works
  class s3 works
  class s4 works
  class s5 works
  class s6 works
