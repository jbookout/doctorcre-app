---- MODULE TaskDestinations ----
\* Generated by chart-to-tla.mjs from task-destinations.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart task-destinations.mmd keeps it, checks it, and compares it with the chart.

VARIABLES selection, screen
vars == <<selection, screen>>

\* Region Selection
selectionStates == {"CallSelected", "NextSelected", "None"}
\* Region Screen
screenStates == {"CallCard", "CallRoute", "NextCard", "NextRoute", "Results", "Unavailable"}

TypeOK ==
    /\ selection \in selectionStates
    /\ screen \in screenStates

Init ==
    /\ selection = "None"
    /\ screen = "Results"

\* Click next action
ClickNextAction ==
    /\ (selection \in {"None"} \/ screen \in {"Results"})
    /\ \/ (selection = "None" /\ selection' = "NextSelected")
       \/ (selection \notin {"None"} /\ UNCHANGED selection)
    /\ \/ (screen = "Results" /\ screen' = "NextRoute")
       \/ (screen \notin {"Results"} /\ UNCHANGED screen)

\* Enter call follow-up
EnterCallFollowUp ==
    /\ (selection \in {"None"} \/ screen \in {"Results"})
    /\ \/ (selection = "None" /\ selection' = "CallSelected")
       \/ (selection \notin {"None"} /\ UNCHANGED selection)
    /\ \/ (screen = "Results" /\ screen' = "CallRoute")
       \/ (screen \notin {"Results"} /\ UNCHANGED screen)

\* Home returns the selected card
HomeReturnsTheSelectedCard ==
    /\ \/ (screen = "NextRoute" /\ screen' = "NextCard")
       \/ (screen = "CallRoute" /\ screen' = "CallCard")
    /\ UNCHANGED <<selection>>

\* Home omits the selected card
HomeOmitsTheSelectedCard ==
    /\ \/ (screen = "NextRoute" /\ screen' = "Unavailable")
       \/ (screen = "CallRoute" /\ screen' = "Unavailable")
    /\ UNCHANGED <<selection>>

Next == ClickNextAction \/ EnterCallFollowUp \/ HomeReturnsTheSelectedCard \/ HomeOmitsTheSelectedCard

Spec == Init /\ [][Next]_vars

\* A call follow-up never opens a next-action card.
NoWrongNextCard == ~(selection = "CallSelected" /\ screen = "NextCard")

\* A next action never opens a call-follow-up card.
NoWrongCallCard == ~(selection = "NextSelected" /\ screen = "CallCard")

\* Home only discloses an unavailable card after a task selection.
NoUnselectedCard == ~(selection = "None" /\ screen = "Unavailable")

====
