            %% when Showing
            AllKinds --> AllKinds: authorization retirement [when Current lead authorized]
            %% when Showing
            OneKind --> AllKinds: authorization retirement [when Current lead authorized]
            %% when Showing
            AllKinds --> AllKinds: disposal [when Current lead authorized, Signed out]
            %% when Showing, Retired
            OneKind --> AllKinds: disposal [when Current lead authorized, Signed out]
            %% when Showing, Retired
        }
        --
        state Subject {
            [*] --> Showing
            state "Current lead authorized" as Showing
            state "Signed out" as Retired
            state "Panel disposed" as Disposed
            Showing --> Showing: lead change
            Showing --> Retired: authorization retirement
            Retired --> Showing: authorized reopen
            Showing --> Disposed: disposal
            Retired --> Disposed: disposal
        }
        --
        state Evidence {
            [*] --> Visible
            state "Current research shown" as Visible
            state "Research cleared" as Hidden
            Visible --> Visible: lead change [when Current lead authorized]
            %% when Showing
            Hidden --> Visible: lead change [when Current lead authorized]
            %% when Showing
            Visible --> Visible: authorized reopen [when Signed out]
            %% when Retired
            Hidden --> Visible: authorized reopen [when Signed out]
            %% when Retired
            Visible --> Hidden: authorization retirement [when Current lead authorized]
            %% when Showing
            Hidden --> Hidden: authorization retirement [when Current lead authorized]
            %% when Showing
            Visible --> Hidden: disposal [when Current lead authorized, Signed out]
            %% when Showing, Retired
            Hidden --> Hidden: disposal [when Current lead authorized, Signed out]
            %% when Showing, Retired
        }
