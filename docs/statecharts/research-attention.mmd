    state Panel {
        state Attention {
            [*] --> All
            state "All findings" as All
            state "Attention selected" as Focused
            All --> Focused: select attention [when Current lead authorized]
            %% when Showing
            Focused --> Focused: select attention [when Current lead authorized]
            %% when Showing
            Focused --> All: clear attention [when Current lead authorized]
            %% when Showing
            All --> All: clear attention [when Current lead authorized]
            %% when Showing
            All --> All: lead change [when Current lead authorized]
            %% when Showing
            Focused --> All: lead change [when Current lead authorized]
            %% when Showing
            All --> All: authorization retirement [when Current lead authorized]
            %% when Showing
            Focused --> All: authorization retirement [when Current lead authorized]
            %% when Showing
            All --> All: disposal [when Current lead authorized, Signed out]
            %% when Showing, Retired
            Focused --> All: disposal [when Current lead authorized, Signed out]
            %% when Showing, Retired
        }
        --
        state Kind {
            [*] --> AllKinds
            state "All finding kinds" as AllKinds
            state "One finding kind" as OneKind
            AllKinds --> OneKind: select kind [when Current lead authorized]
            %% when Showing
            OneKind --> OneKind: select kind [when Current lead authorized]
            %% when Showing
            AllKinds --> AllKinds: clear kind [when Current lead authorized]
            %% when Showing
            OneKind --> AllKinds: clear kind [when Current lead authorized]
            %% when Showing
            AllKinds --> AllKinds: lead change [when Current lead authorized]
            %% when Showing
