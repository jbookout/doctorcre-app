---- MODULE Lifecycle ----
\* Generated by chart-to-tla.mjs from lifecycle.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart lifecycle.mmd keeps it, checks it, and compares it with the chart.

VARIABLES acquisition, result
vars == <<acquisition, result>>

\* Region Acquisition
acquisitionStates == {"AwaitingEndpoint", "Closed", "Closing", "Connecting", "Ready", "Starting"}
\* Region Result
resultStates == {"Pending", "Refused", "Retired", "Returned"}

TypeOK ==
    /\ acquisition \in acquisitionStates
    /\ result \in resultStates

Init ==
    /\ acquisition = "Starting"
    /\ result = "Pending"

\* process started
ProcessStarted ==
    /\ \/ (acquisition = "Starting" /\ acquisition' = "AwaitingEndpoint")
    /\ UNCHANGED <<result>>

\* endpoint received
EndpointReceived ==
    /\ \/ (acquisition = "AwaitingEndpoint" /\ acquisition' = "Connecting")
    /\ UNCHANGED <<result>>

\* handshake succeeds
HandshakeSucceeds ==
    /\ (acquisition \in {"Connecting"} /\ result \in {"Pending"})
    /\ \/ (acquisition = "Connecting" /\ acquisition' = "Ready")
       \/ (acquisition \notin {"Connecting"} /\ UNCHANGED acquisition)
    /\ \/ (result = "Pending" /\ result' = "Returned")
       \/ (result \notin {"Pending"} /\ UNCHANGED result)

\* acquisition fails
AcquisitionFails ==
    /\ (acquisition \in {"Starting", "AwaitingEndpoint", "Connecting"} /\ result \in {"Pending"})
    /\ \/ (acquisition = "Starting" /\ acquisition' = "Closing")
       \/ (acquisition = "AwaitingEndpoint" /\ acquisition' = "Closing")
       \/ (acquisition = "Connecting" /\ acquisition' = "Closing")
       \/ (acquisition \notin {"Starting", "AwaitingEndpoint", "Connecting"} /\ UNCHANGED acquisition)
    /\ \/ (result = "Pending" /\ result' = "Refused")
       \/ (result \notin {"Pending"} /\ UNCHANGED result)

\* owner closes
OwnerCloses ==
    /\ (acquisition \in {"Ready"} /\ result \in {"Returned"})
    /\ \/ (acquisition = "Ready" /\ acquisition' = "Closing")
       \/ (acquisition \notin {"Ready"} /\ UNCHANGED acquisition)
    /\ \/ (result = "Returned" /\ result' = "Retired")
       \/ (result \notin {"Returned"} /\ UNCHANGED result)

\* process exits
ProcessExits ==
    /\ (acquisition \in {"Ready"} /\ result \in {"Returned"})
    /\ \/ (acquisition = "Ready" /\ acquisition' = "Closing")
       \/ (acquisition \notin {"Ready"} /\ UNCHANGED acquisition)
    /\ \/ (result = "Returned" /\ result' = "Retired")
       \/ (result \notin {"Returned"} /\ UNCHANGED result)

\* resources disposed
ResourcesDisposed ==
    /\ \/ (acquisition = "Closing" /\ acquisition' = "Closed")
    /\ UNCHANGED <<result>>

Next == ProcessStarted \/ EndpointReceived \/ HandshakeSucceeds \/ AcquisitionFails \/ OwnerCloses \/ ProcessExits \/ ResourcesDisposed

Spec == Init /\ [][Next]_vars

\* Closing never returns a fixture.
NoLateReturn == ~(acquisition = "Closing" /\ result = "Returned")

\* A closed fixture cannot be returned.
NoClosedReturn == ~(acquisition = "Closed" /\ result = "Returned")

====
