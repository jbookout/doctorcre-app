---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Browser available |<br/>Fixture returned" as s0
  state "Browser disposed |<br/>Acquisition refused" as s1
  state "Browser disposed | Fixture<br/>retired" as s2
  state "Connecting to Chromium |<br/>No fixture returned" as s3
  state "Disposing browser |<br/>Acquisition refused" as s4
  state "Disposing browser |<br/>Fixture retired" as s5
  state "Starting Chromium | No<br/>fixture returned" as s6
  state "Waiting for browser<br/>address | No fixture<br/>returned" as s7
  [*] --> s6
  s6 --> s7 : process started
  s6 --> s4 : acquisition fails
  s7 --> s3 : endpoint received
  s4 --> s1 : resources disposed
  s3 --> s0 : handshake succeeds
  s0 --> s5 : owner closes or process exits
  s5 --> s2 : resources disposed
  class s0 works
  class s1 works
  class s2 works
  class s3 works
  class s4 works
  class s5 works
  class s6 works
  class s7 works
