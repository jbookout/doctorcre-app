---- MODULE BrokerSheet ----
\* Generated by chart-to-tla.mjs from broker-sheet.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart broker-sheet.mmd keeps it, checks it, and compares it with the chart.

VARIABLES sync, access, history
vars == <<sync, access, history>>

\* Region Sync
syncStates == {"Conflict", "Editing", "Regenerating", "Retired", "Saved", "Saving", "Uncertain"}
\* Region Access
accessStates == {"Authorized", "Revoked"}
\* Region History
historyStates == {"Closed", "Hidden", "Reading", "Visible"}

TypeOK ==
    /\ sync \in syncStates
    /\ access \in accessStates
    /\ history \in historyStates

Init ==
    /\ sync = "Saved"
    /\ access = "Authorized"
    /\ history = "Closed"

\* type notes
TypeNotes ==
    /\ \/ (sync = "Saved" /\ sync' = "Editing")
    /\ UNCHANGED <<access, history>>

\* pause or save now
PauseOrSaveNow ==
    /\ \/ (sync = "Editing" /\ sync' = "Saving")
    /\ UNCHANGED <<access, history>>

\* save confirmed
SaveConfirmed ==
    /\ \/ (sync = "Saving" /\ sync' = "Saved")
    /\ UNCHANGED <<access, history>>

\* newer revision found
NewerRevisionFound ==
    /\ \/ (sync = "Saving" /\ sync' = "Conflict")
    /\ UNCHANGED <<access, history>>

\* review current and keep draft
ReviewCurrentAndKeepDraft ==
    /\ \/ (sync = "Conflict" /\ sync' = "Editing")
    /\ UNCHANGED <<access, history>>

\* response lost
ResponseLost ==
    /\ \/ (sync = "Saving" /\ sync' = "Uncertain")
    /\ UNCHANGED <<access, history>>

\* check outcome
CheckOutcome ==
    /\ \/ (sync = "Uncertain" /\ sync' = "Saving")
    /\ UNCHANGED <<access, history>>

\* regenerate
Regenerate ==
    /\ \/ (sync = "Saved" /\ sync' = "Regenerating")
       \/ (sync = "Editing" /\ sync' = "Regenerating")
    /\ UNCHANGED <<access, history>>

\* current facts received
CurrentFactsReceived ==
    /\ \/ (sync = "Regenerating" /\ sync' = "Editing")
    /\ UNCHANGED <<access, history>>

\* facts unavailable resumes autosave
FactsUnavailableResumesAutosave ==
    /\ \/ (sync = "Regenerating" /\ sync' = "Editing")
    /\ UNCHANGED <<access, history>>

\* read revisions
ReadRevisions ==
    /\ (sync \in {"Saved", "Editing"} \/ history \in {"Closed", "Visible"})
    /\ \/ (sync = "Saved" /\ sync' = "Saved")
       \/ (sync = "Editing" /\ sync' = "Editing")
       \/ (sync \notin {"Saved", "Editing"} /\ UNCHANGED sync)
    /\ \/ (history = "Closed" /\ history' = "Reading")
       \/ (history = "Visible" /\ history' = "Visible")
       \/ (history \notin {"Closed", "Visible"} /\ UNCHANGED history)
    /\ UNCHANGED <<access>>

\* session revoked
SessionRevoked ==
    /\ (sync \in {"Saved", "Editing", "Saving", "Conflict", "Uncertain", "Regenerating"} \/ access \in {"Authorized"} \/ history \in {"Reading", "Visible", "Closed"})
    /\ \/ (sync = "Saved" /\ sync' = "Retired")
       \/ (sync = "Editing" /\ sync' = "Retired")
       \/ (sync = "Saving" /\ sync' = "Retired")
       \/ (sync = "Conflict" /\ sync' = "Retired")
       \/ (sync = "Uncertain" /\ sync' = "Retired")
       \/ (sync = "Regenerating" /\ sync' = "Retired")
       \/ (sync \notin {"Saved", "Editing", "Saving", "Conflict", "Uncertain", "Regenerating"} /\ UNCHANGED sync)
    /\ \/ (access = "Authorized" /\ access' = "Revoked")
       \/ (access \notin {"Authorized"} /\ UNCHANGED access)
    /\ \/ (history = "Reading" /\ history' = "Hidden")
       \/ (history = "Visible" /\ history' = "Hidden")
       \/ (history = "Closed" /\ history' = "Hidden")
       \/ (history \notin {"Reading", "Visible", "Closed"} /\ UNCHANGED history)

\* revisions received
RevisionsReceived ==
    /\ \/ (history = "Reading" /\ history' = "Visible")
    /\ UNCHANGED <<sync, access>>

\* revisions unavailable
RevisionsUnavailable ==
    /\ \/ (history = "Reading" /\ history' = "Closed")
    /\ UNCHANGED <<sync, access>>

Next == TypeNotes \/ PauseOrSaveNow \/ SaveConfirmed \/ NewerRevisionFound \/ ReviewCurrentAndKeepDraft \/ ResponseLost \/ CheckOutcome \/ Regenerate \/ CurrentFactsReceived \/ FactsUnavailableResumesAutosave \/ ReadRevisions \/ SessionRevoked \/ RevisionsReceived \/ RevisionsUnavailable

Spec == Init /\ [][Next]_vars

\* A revoked session cannot save.
NoRevokedSave == ~(sync = "Saving" /\ access = "Revoked")

\* A revoked session cannot regenerate.
NoRevokedRegeneration == ~(sync = "Regenerating" /\ access = "Revoked")

\* A revoked session cannot view broker history.
NoHistoryLeak == ~(history = "Visible" /\ access = "Revoked")

====
