---- MODULE J15Chart ----
\* Generated by chart-to-tla.mjs from j15-chart.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart j15-chart.mmd keeps it, checks it, and compares it with the chart.

VARIABLES region1, region2
vars == <<region1, region2>>

\* Region Region1
region1States == {"Closed", "Loading", "Ready", "Refused", "Saving", "Unavailable", "Uncertain"}
\* Region Region2
region2States == {"Confirmed", "Unconfirmed"}

TypeOK ==
    /\ region1 \in region1States
    /\ region2 \in region2States

Init ==
    /\ region1 = "Loading"
    /\ region2 = "Unconfirmed"

\* Both reads succeed
BothReadsSucceed ==
    /\ \/ (region1 = "Loading" /\ region1' = "Ready")
    /\ UNCHANGED <<region2>>

\* Either read fails
EitherReadFails ==
    /\ \/ (region1 = "Loading" /\ region1' = "Unavailable")
    /\ UNCHANGED <<region2>>

\* Refresh
Refresh ==
    /\ \/ (region1 = "Unavailable" /\ region1' = "Loading")
       \/ (region1 = "Ready" /\ region1' = "Loading")
    /\ UNCHANGED <<region2>>

\* Save hidden draft or publish exact file version
SaveHiddenDraftOrPublishExactFileVersion ==
    /\ region1 = "Ready" \* src/ui/client-publications.tsx:266 save accepts ready or uncertain.
    /\ \/ (region1 = "Ready" /\ region1' = "Saving")
       \/ (region1 \notin {"Ready"} /\ UNCHANGED region1)
    /\ \/ (region2 = "Confirmed" /\ region2' = "Unconfirmed")
       \/ (region2 \notin {"Confirmed"} /\ UNCHANGED region2)

\* Receipt advances publication version
ReceiptAdvancesPublicationVersion ==
    /\ region1 = "Saving" \* src/ui/client-publications.tsx:272 receipt only after current save request.
    /\ \/ (region1 = "Saving" /\ region1' = "Loading")
       \/ (region1 \notin {"Saving"} /\ UNCHANGED region1)
    /\ \/ (region2 = "Unconfirmed" /\ region2' = "Confirmed")
       \/ (region2 \notin {"Unconfirmed"} /\ UNCHANGED region2)

\* Server refuses stale or inaccessible content
ServerRefusesStaleOrInaccessibleContent ==
    /\ \/ (region1 = "Saving" /\ region1' = "Refused")
    /\ UNCHANGED <<region2>>

\* Refresh authoritative versions
RefreshAuthoritativeVersions ==
    /\ \/ (region1 = "Refused" /\ region1' = "Loading")
    /\ UNCHANGED <<region2>>

\* Server does not confirm
ServerDoesNotConfirm ==
    /\ \/ (region1 = "Saving" /\ region1' = "Uncertain")
    /\ UNCHANGED <<region2>>

\* Retry same action and key
RetrySameActionAndKey ==
    /\ \/ (region1 = "Uncertain" /\ region1' = "Saving")
    /\ UNCHANGED <<region2>>

\* Refresh current server state
RefreshCurrentServerState ==
    /\ \/ (region1 = "Uncertain" /\ region1' = "Loading")
    /\ UNCHANGED <<region2>>

\* Close deal or session changes
CloseDealOrSessionChanges ==
    /\ \/ (region1 = "Loading" /\ region1' = "Closed")
       \/ (region1 = "Ready" /\ region1' = "Closed")
       \/ (region1 = "Saving" /\ region1' = "Closed")
       \/ (region1 = "Refused" /\ region1' = "Closed")
       \/ (region1 = "Uncertain" /\ region1' = "Closed")
       \/ (region1 = "Unavailable" /\ region1' = "Closed")
    /\ UNCHANGED <<region2>>

Next == BothReadsSucceed \/ EitherReadFails \/ Refresh \/ SaveHiddenDraftOrPublishExactFileVersion \/ ReceiptAdvancesPublicationVersion \/ ServerRefusesStaleOrInaccessibleContent \/ RefreshAuthoritativeVersions \/ ServerDoesNotConfirm \/ RetrySameActionAndKey \/ RefreshCurrentServerState \/ CloseDealOrSessionChanges

Spec == Init /\ [][Next]_vars

\* A pending write never displays a confirmed new version.
SaveAwaitsReceipt == ~(region1 = "Saving" /\ region2 = "Confirmed")

\* Refused writes never confirm a new version.
RefusalIsUnconfirmed == ~(region1 = "Refused" /\ region2 = "Confirmed")

====
