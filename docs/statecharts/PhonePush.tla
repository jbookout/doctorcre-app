---- MODULE PhonePush ----
\* Generated by chart-to-tla.mjs from phone-push.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart phone-push.mmd keeps it, checks it, and compares it with the chart.

VARIABLES session, notifications
vars == <<session, notifications>>

\* Region Session
sessionStates == {"Session ended", "Signed in"}
\* Region Notifications
notificationsStates == {"Browser cleanup needed", "Notifications enabled", "Notifications off", "Permission blocked", "Permission prompt", "Platform unsupported", "Registration unconfirmed", "Revocation unconfirmed", "Sign in again", "Turning notifications off", "Waiting for registration"}

TypeOK ==
    /\ session \in sessionStates
    /\ notifications \in notificationsStates

Init ==
    /\ session = "Signed in"
    /\ notifications = "Notifications off"

\* Session ends
SessionEnds ==
    /\ (session \in {"Signed in"} \/ notifications \in {"Notifications off", "Platform unsupported", "Permission prompt", "Permission blocked", "Waiting for registration", "Notifications enabled", "Registration unconfirmed", "Turning notifications off", "Revocation unconfirmed", "Browser cleanup needed"})
    /\ \/ (session = "Signed in" /\ session' = "Session ended")
       \/ (session \notin {"Signed in"} /\ UNCHANGED session)
    /\ \/ (notifications = "Notifications off" /\ notifications' = "Sign in again")
       \/ (notifications = "Platform unsupported" /\ notifications' = "Sign in again")
       \/ (notifications = "Permission prompt" /\ notifications' = "Sign in again")
       \/ (notifications = "Permission blocked" /\ notifications' = "Sign in again")
       \/ (notifications = "Waiting for registration" /\ notifications' = "Sign in again")
       \/ (notifications = "Notifications enabled" /\ notifications' = "Sign in again")
       \/ (notifications = "Registration unconfirmed" /\ notifications' = "Sign in again")
       \/ (notifications = "Turning notifications off" /\ notifications' = "Sign in again")
       \/ (notifications = "Revocation unconfirmed" /\ notifications' = "Sign in again")
       \/ (notifications = "Browser cleanup needed" /\ notifications' = "Sign in again")
       \/ (notifications \notin {"Notifications off", "Platform unsupported", "Permission prompt", "Permission blocked", "Waiting for registration", "Notifications enabled", "Registration unconfirmed", "Turning notifications off", "Revocation unconfirmed", "Browser cleanup needed"} /\ UNCHANGED notifications)

\* Support unavailable
SupportUnavailable ==
    /\ \/ (notifications = "Notifications off" /\ notifications' = "Platform unsupported")
    /\ UNCHANGED <<session>>

\* Tap enable
TapEnable ==
    /\ \/ (notifications = "Notifications off" /\ notifications' = "Permission prompt")
       \/ (notifications = "Permission blocked" /\ notifications' = "Permission prompt")
    /\ UNCHANGED <<session>>

\* Allow
Allow ==
    /\ \/ (notifications = "Permission prompt" /\ notifications' = "Waiting for registration")
    /\ UNCHANGED <<session>>

\* Deny
Deny ==
    /\ \/ (notifications = "Permission prompt" /\ notifications' = "Permission blocked")
    /\ UNCHANGED <<session>>

\* Dismiss
Dismiss ==
    /\ \/ (notifications = "Permission prompt" /\ notifications' = "Notifications off")
    /\ UNCHANGED <<session>>

\* Server confirms
ServerConfirms ==
    /\ \/ (notifications = "Waiting for registration" /\ notifications' = "Notifications enabled")
    /\ UNCHANGED <<session>>

\* Receipt lost
ReceiptLost ==
    /\ \/ (notifications = "Waiting for registration" /\ notifications' = "Registration unconfirmed")
    /\ UNCHANGED <<session>>

\* Check outcome
CheckOutcome ==
    /\ \/ (notifications = "Registration unconfirmed" /\ notifications' = "Waiting for registration")
    /\ UNCHANGED <<session>>

\* Tap disable
TapDisable ==
    /\ \/ (notifications = "Notifications enabled" /\ notifications' = "Turning notifications off")
    /\ UNCHANGED <<session>>

\* Revocation receipt lost
RevocationReceiptLost ==
    /\ \/ (notifications = "Turning notifications off" /\ notifications' = "Revocation unconfirmed")
    /\ UNCHANGED <<session>>

\* Check revocation
CheckRevocation ==
    /\ \/ (notifications = "Revocation unconfirmed" /\ notifications' = "Turning notifications off")
    /\ UNCHANGED <<session>>

\* Revoked and unsubscribed
RevokedAndUnsubscribed ==
    /\ \/ (notifications = "Turning notifications off" /\ notifications' = "Notifications off")
    /\ UNCHANGED <<session>>

\* Browser cleanup failed
BrowserCleanupFailed ==
    /\ \/ (notifications = "Turning notifications off" /\ notifications' = "Browser cleanup needed")
    /\ UNCHANGED <<session>>

\* Retry browser cleanup
RetryBrowserCleanup ==
    /\ \/ (notifications = "Browser cleanup needed" /\ notifications' = "Notifications off")
    /\ UNCHANGED <<session>>

\* Permission revoked
PermissionRevoked ==
    /\ \/ (notifications = "Notifications enabled" /\ notifications' = "Notifications off")
    /\ UNCHANGED <<session>>

Next == SessionEnds \/ SupportUnavailable \/ TapEnable \/ Allow \/ Deny \/ Dismiss \/ ServerConfirms \/ ReceiptLost \/ CheckOutcome \/ TapDisable \/ RevocationReceiptLost \/ CheckRevocation \/ RevokedAndUnsubscribed \/ BrowserCleanupFailed \/ RetryBrowserCleanup \/ PermissionRevoked

Spec == Init /\ [][Next]_vars

\* A closed session never shows enabled
SignedOutEnabled == ~(session = "Session ended" /\ notifications = "Notifications enabled")

\* A closed session cannot register
SignedOutRegistering == ~(session = "Session ended" /\ notifications = "Waiting for registration")

\* A closed session cannot start a write
SignedOutRevoking == ~(session = "Session ended" /\ notifications = "Turning notifications off")

====
