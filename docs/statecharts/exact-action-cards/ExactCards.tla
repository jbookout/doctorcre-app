---- MODULE ExactCards ----
\* Generated by chart-to-tla.mjs from ExactCards.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart ExactCards.mmd keeps it, checks it, and compares it with the chart.

VARIABLES session, card
vars == <<session, card>>

\* Region Session
sessionStates == {"Session available", "Sign in to continue"}
\* Region Card
cardStates == {"Changed card, no actions", "Opening the named card", "Resolved card, no actions", "Retired source, no detail", "Review the exact card", "Unavailable, no detail"}

TypeOK ==
    /\ session \in sessionStates
    /\ card \in cardStates

Init ==
    /\ session = "Session available"
    /\ card = "Opening the named card"

\* session refused
SessionRefused ==
    /\ (session \in {"Session available"} \/ card \in {"Opening the named card", "Review the exact card", "Resolved card, no actions", "Changed card, no actions", "Retired source, no detail", "Unavailable, no detail"})
    /\ \/ (session = "Session available" /\ session' = "Sign in to continue")
       \/ (session \notin {"Session available"} /\ UNCHANGED session)
    /\ \/ (card = "Opening the named card" /\ card' = "Unavailable, no detail")
       \/ (card = "Review the exact card" /\ card' = "Unavailable, no detail")
       \/ (card = "Resolved card, no actions" /\ card' = "Unavailable, no detail")
       \/ (card = "Changed card, no actions" /\ card' = "Unavailable, no detail")
       \/ (card = "Retired source, no detail" /\ card' = "Unavailable, no detail")
       \/ (card = "Unavailable, no detail" /\ card' = "Unavailable, no detail")
       \/ (card \notin {"Opening the named card", "Review the exact card", "Resolved card, no actions", "Changed card, no actions", "Retired source, no detail", "Unavailable, no detail"} /\ UNCHANGED card)

\* sign in to same reference
SignInToSameReference ==
    /\ (session \in {"Sign in to continue"} \/ card \in {"Unavailable, no detail"})
    /\ \/ (session = "Sign in to continue" /\ session' = "Session available")
       \/ (session \notin {"Sign in to continue"} /\ UNCHANGED session)
    /\ \/ (card = "Unavailable, no detail" /\ card' = "Opening the named card")
       \/ (card \notin {"Unavailable, no detail"} /\ UNCHANGED card)

\* authorized current source
AuthorizedCurrentSource ==
    /\ (session \in {"Session available"} \/ (card = "Opening the named card" /\ session = "Session available"))
    /\ \/ (session = "Session available" /\ session' = "Session available")
       \/ (session \notin {"Session available"} /\ UNCHANGED session)
    /\ \/ (card = "Opening the named card" /\ session = "Session available" /\ card' = "Review the exact card")
       \/ (~((card = "Opening the named card" /\ session = "Session available")) /\ UNCHANGED card)

\* source resolved
SourceResolved ==
    /\ (session \in {"Session available"} \/ (card = "Opening the named card" /\ session = "Session available"))
    /\ \/ (session = "Session available" /\ session' = "Session available")
       \/ (session \notin {"Session available"} /\ UNCHANGED session)
    /\ \/ (card = "Opening the named card" /\ session = "Session available" /\ card' = "Resolved card, no actions")
       \/ (~((card = "Opening the named card" /\ session = "Session available")) /\ UNCHANGED card)

\* source changed
SourceChanged ==
    /\ (session \in {"Session available"} \/ (card = "Opening the named card" /\ session = "Session available"))
    /\ \/ (session = "Session available" /\ session' = "Session available")
       \/ (session \notin {"Session available"} /\ UNCHANGED session)
    /\ \/ (card = "Opening the named card" /\ session = "Session available" /\ card' = "Changed card, no actions")
       \/ (~((card = "Opening the named card" /\ session = "Session available")) /\ UNCHANGED card)

\* source retired
SourceRetired ==
    /\ (session \in {"Session available"} \/ card \in {"Opening the named card"})
    /\ \/ (session = "Session available" /\ session' = "Session available")
       \/ (session \notin {"Session available"} /\ UNCHANGED session)
    /\ \/ (card = "Opening the named card" /\ card' = "Retired source, no detail")
       \/ (card \notin {"Opening the named card"} /\ UNCHANGED card)

\* invalid or foreign reference or network failure
InvalidOrForeignReferenceOrNetworkFailure ==
    /\ \/ (card = "Opening the named card" /\ card' = "Unavailable, no detail")
    /\ UNCHANGED <<session>>

\* user reloads
UserReloads ==
    /\ \/ (card = "Unavailable, no detail" /\ card' = "Opening the named card")
    /\ UNCHANGED <<session>>

\* matching review receipt
MatchingReviewReceipt ==
    /\ \/ (card = "Review the exact card" /\ card' = "Opening the named card")
    /\ UNCHANGED <<session>>

\* write refuses changed source
WriteRefusesChangedSource ==
    /\ \/ (card = "Review the exact card" /\ card' = "Changed card, no actions")
    /\ UNCHANGED <<session>>

\* open current version
OpenCurrentVersion ==
    /\ \/ (card = "Changed card, no actions" /\ session = "Session available" /\ card' = "Opening the named card")
    /\ UNCHANGED <<session>>

Next == SessionRefused \/ SignInToSameReference \/ AuthorizedCurrentSource \/ SourceResolved \/ SourceChanged \/ SourceRetired \/ InvalidOrForeignReferenceOrNetworkFailure \/ UserReloads \/ MatchingReviewReceipt \/ WriteRefusesChangedSource \/ OpenCurrentVersion

Spec == Init /\ [][Next]_vars

\* Refused sessions never show pending private detail.
PrivatePending == ~(session = "Sign in to continue" /\ card = "Review the exact card")

\* Refused sessions never show resolved private detail.
PrivateResolved == ~(session = "Sign in to continue" /\ card = "Resolved card, no actions")

\* Refused sessions never show stale private detail.
PrivateStale == ~(session = "Sign in to continue" /\ card = "Changed card, no actions")

====
