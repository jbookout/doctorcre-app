---- MODULE ReviewIntent ----
\* Generated by chart-to-tla.mjs from ReviewIntent.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart ReviewIntent.mmd keeps it, checks it, and compares it with the chart.

VARIABLES access, intent
vars == <<access, intent>>

\* Region Access
accessStates == {"Authorized session", "Private view retired"}
\* Region Intent
intentStates == {"No private command", "Open changed source", "Retry same review", "Review confirmed", "Review current card", "Saving exact review"}

TypeOK ==
    /\ access \in accessStates
    /\ intent \in intentStates

Init ==
    /\ access = "Authorized session"
    /\ intent = "Review current card"

\* session refused or sign out
SessionRefusedOrSignOut ==
    /\ (access \in {"Authorized session"} \/ intent \in {"Review current card", "Saving exact review", "Retry same review", "Review confirmed", "Open changed source"})
    /\ \/ (access = "Authorized session" /\ access' = "Private view retired")
       \/ (access \notin {"Authorized session"} /\ UNCHANGED access)
    /\ \/ (intent = "Review current card" /\ intent' = "No private command")
       \/ (intent = "Saving exact review" /\ intent' = "No private command")
       \/ (intent = "Retry same review" /\ intent' = "No private command")
       \/ (intent = "Review confirmed" /\ intent' = "No private command")
       \/ (intent = "Open changed source" /\ intent' = "No private command")
       \/ (intent \notin {"Review current card", "Saving exact review", "Retry same review", "Review confirmed", "Open changed source"} /\ UNCHANGED intent)

\* verify session and reopen card
VerifySessionAndReopenCard ==
    /\ (access \in {"Private view retired"} \/ intent \in {"No private command"})
    /\ \/ (access = "Private view retired" /\ access' = "Authorized session")
       \/ (access \notin {"Private view retired"} /\ UNCHANGED access)
    /\ \/ (intent = "No private command" /\ intent' = "Review current card")
       \/ (intent \notin {"No private command"} /\ UNCHANGED intent)

\* tap review
TapReview ==
    /\ \/ (intent = "Review current card" /\ access = "Authorized session" /\ intent' = "Saving exact review")
    /\ UNCHANGED <<access>>

\* retry review
RetryReview ==
    /\ \/ (intent = "Retry same review" /\ access = "Authorized session" /\ intent' = "Saving exact review")
    /\ UNCHANGED <<access>>

\* lost reply or retryable error
LostReplyOrRetryableError ==
    /\ \/ (intent = "Saving exact review" /\ intent' = "Retry same review")
    /\ UNCHANGED <<access>>

\* reload authorized card
ReloadAuthorizedCard ==
    /\ \/ (intent = "Retry same review" /\ intent' = "Review current card")
    /\ UNCHANGED <<access>>

\* matching receipt
MatchingReceipt ==
    /\ \/ (intent = "Saving exact review" /\ intent' = "Review confirmed")
    /\ UNCHANGED <<access>>

\* source version changed
SourceVersionChanged ==
    /\ \/ (intent = "Saving exact review" /\ intent' = "Open changed source")
    /\ UNCHANGED <<access>>

\* open current version
OpenCurrentVersion ==
    /\ \/ (intent = "Open changed source" /\ intent' = "Review current card")
    /\ UNCHANGED <<access>>

Next == SessionRefusedOrSignOut \/ VerifySessionAndReopenCard \/ TapReview \/ RetryReview \/ LostReplyOrRetryableError \/ ReloadAuthorizedCard \/ MatchingReceipt \/ SourceVersionChanged \/ OpenCurrentVersion

Spec == Init /\ [][Next]_vars

\* A retired session never sends a review.
PrivateSend == ~(access = "Private view retired" /\ intent = "Saving exact review")

\* A retired session never shows a private command.
PrivateEligible == ~(access = "Private view retired" /\ intent = "Review current card")

\* A retired session never offers a private retry.
PrivateRetry == ~(access = "Private view retired" /\ intent = "Retry same review")

====
