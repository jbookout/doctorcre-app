---- MODULE Chart ----
\* Generated by chart-to-tla.mjs from chart.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart chart.mmd keeps it, checks it, and compares it with the chart.

VARIABLES access, document
vars == <<access, document>>

\* Region Access
accessStates == {"Checking", "Granted", "Unavailable"}
\* Region Document
documentStates == {"Empty", "Opening", "PrintDialog", "Ready"}

TypeOK ==
    /\ access \in accessStates
    /\ document \in documentStates

Init ==
    /\ access = "Checking"
    /\ document = "Opening"

\* Approved facts and matching map arrive
ApprovedFactsAndMatchingMapArrive ==
    /\ (access \in {"Checking"} \/ document \in {"Opening"}) \* reports/share.js:284-300
    /\ \/ (access = "Checking" /\ access' = "Granted")
       \/ (access \notin {"Checking"} /\ UNCHANGED access)
    /\ \/ (document = "Opening" /\ document' = "Ready")
       \/ (document \notin {"Opening"} /\ UNCHANGED document)

\* Read or parity check fails
\* reports/share.js:332-333 catches failed loads and clears both regions.
ReadOrParityCheckFails ==
    /\ (access \in {"Checking"} \/ document \in {"Opening"})
    /\ \/ (access = "Checking" /\ access' = "Unavailable")
       \/ (access \notin {"Checking"} /\ UNCHANGED access)
    /\ \/ (document = "Opening" /\ document' = "Empty")
       \/ (document \notin {"Opening"} /\ UNCHANGED document)

\* Access changes
\* reports/share.js:62-74 clears the DOM, map and print control synchronously.
AccessChanges ==
    /\ (access \in {"Granted"} \/ document \in {"Ready", "PrintDialog"})
    /\ \/ (access = "Granted" /\ access' = "Unavailable")
       \/ (access \notin {"Granted"} /\ UNCHANGED access)
    /\ \/ (document = "Ready" /\ document' = "Empty")
       \/ (document = "PrintDialog" /\ document' = "Empty")
       \/ (document \notin {"Ready", "PrintDialog"} /\ UNCHANGED document)

\* Save PDF
\* reports/share.js:58 permits print only while valid with report properties.
SavePDF ==
    /\ \/ (document = "Ready" /\ document' = "PrintDialog")
    /\ UNCHANGED <<access>>

\* Close print dialog
\* Native print-dialog closure leaves the page unchanged.
ClosePrintDialog ==
    /\ \/ (document = "PrintDialog" /\ document' = "Ready")
    /\ UNCHANGED <<access>>

Next == ApprovedFactsAndMatchingMapArrive \/ ReadOrParityCheckFails \/ AccessChanges \/ SavePDF \/ ClosePrintDialog

Spec == Init /\ [][Next]_vars

\* Unavailable access never shows the prior packet.
RefusedPacket == ~(access = "Unavailable" /\ document = "Ready")

\* Unavailable access never permits starting a print.
RefusedPrint == ~(access = "Unavailable" /\ document = "PrintDialog")

====
