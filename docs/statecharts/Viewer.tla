---- MODULE Viewer ----
\* Generated by chart-to-tla.mjs from viewer.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart viewer.mmd keeps it, checks it, and compares it with the chart.

VARIABLES lifecycle, requestIdentity
vars == <<lifecycle, requestIdentity>>

\* Region Lifecycle
lifecycleStates == {"Closed", "Expired", "Loading", "NoText", "Ready", "SourceChanged", "Unavailable"}
\* Region RequestIdentity
requestIdentityStates == {"Current", "Empty", "Pending", "Retired"}

TypeOK ==
    /\ lifecycle \in lifecycleStates
    /\ requestIdentity \in requestIdentityStates

Init ==
    /\ lifecycle = "Closed"
    /\ requestIdentity = "Empty"

\* Open
Open ==
    /\ (lifecycle \in {"Closed"} \/ requestIdentity \in {"Empty"})
    /\ \/ (lifecycle = "Closed" /\ lifecycle' = "Loading")
       \/ (lifecycle \notin {"Closed"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Empty" /\ requestIdentity' = "Pending")
       \/ (requestIdentity \notin {"Empty"} /\ UNCHANGED requestIdentity)

\* Produced
Produced ==
    /\ (lifecycle \in {"Loading"} \/ requestIdentity \in {"Pending"})
    /\ \/ (lifecycle = "Loading" /\ lifecycle' = "Ready")
       \/ (lifecycle \notin {"Loading"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Pending" /\ requestIdentity' = "Current")
       \/ (requestIdentity \notin {"Pending"} /\ UNCHANGED requestIdentity)

\* Failed
Failed ==
    /\ (lifecycle \in {"Loading"} \/ requestIdentity \in {"Pending"})
    /\ \/ (lifecycle = "Loading" /\ lifecycle' = "Unavailable")
       \/ (lifecycle \notin {"Loading"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Pending" /\ requestIdentity' = "Empty")
       \/ (requestIdentity \notin {"Pending"} /\ UNCHANGED requestIdentity)

\* NoTextFound
NoTextFound ==
    /\ (lifecycle \in {"Loading"} \/ requestIdentity \in {"Pending"})
    /\ \/ (lifecycle = "Loading" /\ lifecycle' = "NoText")
       \/ (lifecycle \notin {"Loading"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Pending" /\ requestIdentity' = "Empty")
       \/ (requestIdentity \notin {"Pending"} /\ UNCHANGED requestIdentity)

\* Changed
Changed ==
    /\ (lifecycle \in {"Loading"} \/ requestIdentity \in {"Pending"})
    /\ \/ (lifecycle = "Loading" /\ lifecycle' = "SourceChanged")
       \/ (lifecycle \notin {"Loading"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Pending" /\ requestIdentity' = "Empty")
       \/ (requestIdentity \notin {"Pending"} /\ UNCHANGED requestIdentity)

\* Navigate
Navigate ==
    /\ (lifecycle \in {"Ready"} \/ requestIdentity \in {"Current"})
    /\ \/ (lifecycle = "Ready" /\ lifecycle' = "Loading")
       \/ (lifecycle \notin {"Ready"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Current" /\ requestIdentity' = "Pending")
       \/ (requestIdentity \notin {"Current"} /\ UNCHANGED requestIdentity)

\* Retry
Retry ==
    /\ (lifecycle \in {"Unavailable", "NoText"} \/ requestIdentity \in {"Empty"})
    /\ \/ (lifecycle = "Unavailable" /\ lifecycle' = "Loading")
       \/ (lifecycle = "NoText" /\ lifecycle' = "Loading")
       \/ (lifecycle \notin {"Unavailable", "NoText"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Empty" /\ requestIdentity' = "Pending")
       \/ (requestIdentity \notin {"Empty"} /\ UNCHANGED requestIdentity)

\* Close
Close ==
    /\ (lifecycle \in {"SourceChanged", "Loading", "Ready", "Unavailable", "NoText"} \/ requestIdentity \in {"Pending", "Current", "Empty"})
    /\ \/ (lifecycle = "SourceChanged" /\ lifecycle' = "Closed")
       \/ (lifecycle = "Loading" /\ lifecycle' = "Closed")
       \/ (lifecycle = "Ready" /\ lifecycle' = "Closed")
       \/ (lifecycle = "Unavailable" /\ lifecycle' = "Closed")
       \/ (lifecycle = "NoText" /\ lifecycle' = "Closed")
       \/ (lifecycle \notin {"SourceChanged", "Loading", "Ready", "Unavailable", "NoText"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Pending" /\ requestIdentity' = "Empty")
       \/ (requestIdentity = "Current" /\ requestIdentity' = "Empty")
       \/ (requestIdentity = "Empty" /\ requestIdentity' = "Empty")
       \/ (requestIdentity \notin {"Pending", "Current", "Empty"} /\ UNCHANGED requestIdentity)

\* Switch
Switch ==
    /\ (lifecycle \in {"Loading", "Ready", "Unavailable", "NoText", "SourceChanged"} \/ requestIdentity \in {"Pending", "Current", "Empty"})
    /\ \/ (lifecycle = "Loading" /\ lifecycle' = "Loading")
       \/ (lifecycle = "Ready" /\ lifecycle' = "Loading")
       \/ (lifecycle = "Unavailable" /\ lifecycle' = "Loading")
       \/ (lifecycle = "NoText" /\ lifecycle' = "Loading")
       \/ (lifecycle = "SourceChanged" /\ lifecycle' = "Loading")
       \/ (lifecycle \notin {"Loading", "Ready", "Unavailable", "NoText", "SourceChanged"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Pending" /\ requestIdentity' = "Pending")
       \/ (requestIdentity = "Current" /\ requestIdentity' = "Pending")
       \/ (requestIdentity = "Empty" /\ requestIdentity' = "Pending")
       \/ (requestIdentity \notin {"Pending", "Current", "Empty"} /\ UNCHANGED requestIdentity)

\* Retire
Retire ==
    /\ (lifecycle \in {"Closed", "Loading", "Ready", "Unavailable", "NoText", "SourceChanged"} \/ requestIdentity \in {"Empty", "Pending", "Current"})
    /\ \/ (lifecycle = "Closed" /\ lifecycle' = "Expired")
       \/ (lifecycle = "Loading" /\ lifecycle' = "Expired")
       \/ (lifecycle = "Ready" /\ lifecycle' = "Expired")
       \/ (lifecycle = "Unavailable" /\ lifecycle' = "Expired")
       \/ (lifecycle = "NoText" /\ lifecycle' = "Expired")
       \/ (lifecycle = "SourceChanged" /\ lifecycle' = "Expired")
       \/ (lifecycle \notin {"Closed", "Loading", "Ready", "Unavailable", "NoText", "SourceChanged"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Empty" /\ requestIdentity' = "Retired")
       \/ (requestIdentity = "Pending" /\ requestIdentity' = "Retired")
       \/ (requestIdentity = "Current" /\ requestIdentity' = "Retired")
       \/ (requestIdentity \notin {"Empty", "Pending", "Current"} /\ UNCHANGED requestIdentity)

\* Late
Late ==
    /\ (lifecycle \in {"Expired", "Closed", "Loading", "Ready", "Unavailable", "NoText", "SourceChanged"} \/ requestIdentity \in {"Retired", "Empty", "Pending", "Current"})
    /\ \/ (lifecycle = "Expired" /\ lifecycle' = "Expired")
       \/ (lifecycle = "Closed" /\ lifecycle' = "Closed")
       \/ (lifecycle = "Loading" /\ lifecycle' = "Loading")
       \/ (lifecycle = "Ready" /\ lifecycle' = "Ready")
       \/ (lifecycle = "Unavailable" /\ lifecycle' = "Unavailable")
       \/ (lifecycle = "NoText" /\ lifecycle' = "NoText")
       \/ (lifecycle = "SourceChanged" /\ lifecycle' = "SourceChanged")
       \/ (lifecycle \notin {"Expired", "Closed", "Loading", "Ready", "Unavailable", "NoText", "SourceChanged"} /\ UNCHANGED lifecycle)
    /\ \/ (requestIdentity = "Retired" /\ requestIdentity' = "Retired")
       \/ (requestIdentity = "Empty" /\ requestIdentity' = "Empty")
       \/ (requestIdentity = "Pending" /\ requestIdentity' = "Pending")
       \/ (requestIdentity = "Current" /\ requestIdentity' = "Current")
       \/ (requestIdentity \notin {"Retired", "Empty", "Pending", "Current"} /\ UNCHANGED requestIdentity)

Next == Open \/ Produced \/ Failed \/ NoTextFound \/ Changed \/ Navigate \/ Retry \/ Close \/ Switch \/ Retire \/ Late

Spec == Init /\ [][Next]_vars

\* Text never appears for an outstanding or replaced identity.
NoCrossIdentity == ~(lifecycle = "Ready" /\ requestIdentity = "Pending")

\* Retiring the session clears all retained text.
NoPostExpiryText == ~(lifecycle = "Expired" /\ requestIdentity = "Current")

====
