#!/usr/bin/env node
import { spawn, execFileSync } from 'node:child_process';
import { readFile, readdir } from 'node:fs/promises';
import { dirname, resolve, relative } from 'node:path';
import { fileURLToPath } from 'node:url';
import { isBuiltin } from 'node:module';
import { init, parse } from 'es-module-lexer';

await init;

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const git = (...args) => execFileSync('git', args, { cwd: root, encoding: 'utf8', timeout: 10_000 }).trim();
const ZERO = /^0+$/;
const budget = 170_000;
const deadlineMessage = 'pre-push: fast checks exceeded 170 seconds; push refused without starting browser tests';
const started = Date.now();
const environment = { ...process.env };
delete environment.NODE_TEST_CONTEXT;

async function browserFree(path, seen = new Set()) {
  if (seen.has(path)) return true;
  seen.add(path);
  let source, imports;
  try {
    source = await readFile(resolve(root, path), 'utf8');
    [imports] = parse(source);
  } catch { return false; }
  if (/browser|chromium|webkit|playwright|puppeteer|\be2e\b|\.launch\s*\(|\brequire\s*\(/i.test(source)) return false;
  for (const { n: specifier, d: dynamic } of imports) {
    if (dynamic === -2) continue; // import.meta has no dependency.
    if (specifier === undefined) return false;
    if (isBuiltin(specifier)) continue;
    if (!specifier.startsWith('./') && !specifier.startsWith('../')) return false;
    const dependency = relative(root, resolve(dirname(resolve(root, path)), specifier));
    if (dependency.startsWith('../') || !/\.m?js$/.test(dependency)) return false;
    if (!await browserFree(dependency, seen)) return false;
  }
  return true;
}
async function fastTests(paths) {
  const selected = [];
  for (const path of paths) if (await browserFree(path)) selected.push(path);
  return selected;
}
function run(command, args, timeout = budget - (Date.now() - started)) {
  if (timeout <= 0) { console.error(deadlineMessage); return Promise.resolve(124); }
  return new Promise(done => {
    const child = spawn(command, args, { cwd: root, detached: true, stdio: 'inherit', env: environment });
    let expired = false, force;
    const timer = setTimeout(() => {
      expired = true;
      console.error(deadlineMessage);
      try { process.kill(-child.pid, 'SIGTERM'); } catch {}
      force = setTimeout(() => { try { process.kill(-child.pid, 'SIGKILL'); } catch {} done(124); }, 1_000);
    }, timeout);
    child.on('error', () => { clearTimeout(timer); done(1); });
    child.on('close', code => { if (expired) return; clearTimeout(timer); clearTimeout(force); done(code ?? 1); });
  });
}
const testArgs = paths => ['--test', '--test-concurrency=2',
  ...paths];

async function main() {
  if (process.argv[2] === '--test') {
    const all = (await readdir(resolve(root, 'test'))).filter(name => name.endsWith('.test.mjs')).map(name => `test/${name}`).sort();
    if (process.argv[3] !== '--fast' || process.argv.length !== 4) throw Error('invalid test invocation');
    return run(process.execPath, testArgs(await fastTests(all)));
  }
  let input = '';
  for await (const chunk of process.stdin) input += chunk;
  const changes = new Set();
  let updates = 0;
  for (const line of input.trim().split('\n').filter(Boolean)) {
    const [localRef, localSha, remoteRef, remoteSha] = line.split(/\s+/);
    if (!remoteRef || !/^[a-f0-9]{40,64}$/.test(localSha) || !/^[a-f0-9]{40,64}$/.test(remoteSha)) throw Error('invalid push input');
    if (ZERO.test(localSha)) continue;
    updates++;
    if (localSha !== git('rev-parse', 'HEAD')) throw Error('push HEAD so local checks validate the outgoing commit');
    const base = ZERO.test(remoteSha) ? (git('rev-parse', '--verify', 'refs/remotes/origin/main')) : remoteSha;
    for (const path of git('diff', '--name-only', '--diff-filter=ACMRT', `${base}...${localSha}`, '--').split('\n').filter(Boolean)) changes.add(path);
  }
  if (!updates) return 0;
  if (git('status', '--porcelain', '--untracked-files=normal')) throw Error('commit or stash working changes before validating the outgoing source');
  console.log('pre-push: repository checks and browser-free Node tests, bounded to 170 seconds');
  let status = await run('npm', ['run', 'check']);
  if (status) return status;
  status = await run('npm', ['run', 'lint']);
  if (status) return status;
  if (/(?:^|\s|["'])--test[-_](?:name[-_]pattern|skip[-_]pattern|only|shard|rerun[-_]failures)(?:=|\s|["']|$)/.test(environment.NODE_OPTIONS || '')) throw Error('filtered Node test selection cannot validate a push');
  const touched = [...changes].filter(path => /^test\/[a-z0-9_-]+\.test\.mjs$/i.test(path));
  const tests = await fastTests(touched);
  status = tests.length ? await run(process.execPath, testArgs(tests)) : await run(process.execPath, [fileURLToPath(import.meta.url), '--test', '--fast']);
  return status;
}
main().then(code => { process.exitCode = code; }).catch(error => { console.error(`pre-push: ${error.message}`); process.exitCode = 1; });
