---- MODULE Switcher ----
\* Generated by chart-to-tla.mjs from switcher.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart switcher.mmd keeps it, checks it, and compares it with the chart.

VARIABLES session, results
vars == <<session, results>>

\* Region Session
sessionStates == {"Retired", "SignedIn"}
\* Region Results
resultsStates == {"Closed", "Loading", "Ready"}

TypeOK ==
    /\ session \in sessionStates
    /\ results \in resultsStates

Init ==
    /\ session = "SignedIn"
    /\ results = "Closed"

\* session ends
SessionEnds ==
    /\ (session \in {"SignedIn"} \/ results \in {"Closed", "Loading", "Ready"})
    /\ \/ (session = "SignedIn" /\ session' = "Retired")
       \/ (session \notin {"SignedIn"} /\ UNCHANGED session)
    /\ \/ (results = "Closed" /\ results' = "Closed")
       \/ (results = "Loading" /\ results' = "Closed")
       \/ (results = "Ready" /\ results' = "Closed")
       \/ (results \notin {"Closed", "Loading", "Ready"} /\ UNCHANGED results)

\* open
Open ==
    /\ session = "SignedIn" \* js/app-shell.js:44 rejects retired open.
    /\ \/ (results = "Closed" /\ results' = "Loading")
    /\ UNCHANGED <<session>>

\* sources settle
SourcesSettle ==
    /\ \/ (results = "Loading" /\ results' = "Ready")
    /\ UNCHANGED <<session>>

\* retry
Retry ==
    /\ \/ (results = "Ready" /\ results' = "Loading")
    /\ UNCHANGED <<session>>

\* close
Close ==
    /\ \/ (results = "Loading" /\ results' = "Closed")
       \/ (results = "Ready" /\ results' = "Closed")
    /\ UNCHANGED <<session>>

Next == SessionEnds \/ Open \/ SourcesSettle \/ Retry \/ Close

Spec == Init /\ [][Next]_vars

\* A retired session never displays private results.
NoRetiredResults == ~(session = "Retired" /\ results = "Ready")

\* A retired session never starts a read.
NoRetiredRead == ~(session = "Retired" /\ results = "Loading")

====
