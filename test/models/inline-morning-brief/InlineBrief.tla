---- MODULE InlineBrief ----
\* Generated by chart-to-tla.mjs from brief.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart brief.mmd keeps it, checks it, and compares it with the chart.

VARIABLES main
vars == <<main>>

\* Region Main
mainStates == {"Partial", "Queue", "Reading", "Ready", "Record", "Retired", "Unavailable"}

TypeOK ==
    /\ main \in mainStates

Init ==
    /\ main = "Reading"

\* Brief arrives
BriefArrives ==
    /\ \/ (main = "Reading" /\ main' = "Ready")

\* Some sources fail
SomeSourcesFail ==
    /\ \/ (main = "Reading" /\ main' = "Partial")

\* Read fails
ReadFails ==
    /\ \/ (main = "Reading" /\ main' = "Unavailable")

\* Refresh
Refresh ==
    /\ \/ (main = "Ready" /\ main' = "Reading")
       \/ (main = "Partial" /\ main' = "Reading")

\* Retry
Retry ==
    /\ \/ (main = "Unavailable" /\ main' = "Reading")

\* Open queue
OpenQueue ==
    /\ \/ (main = "Ready" /\ main' = "Queue")
       \/ (main = "Partial" /\ main' = "Queue")

\* Open priority
OpenPriority ==
    /\ \/ (main = "Ready" /\ main' = "Record")
       \/ (main = "Partial" /\ main' = "Record")

\* Return to brief
ReturnToBrief ==
    /\ \/ (main = "Queue" /\ main' = "Ready")
       \/ (main = "Record" /\ main' = "Ready")

\* Actor changes
ActorChanges ==
    /\ \/ (main = "Reading" /\ main' = "Retired")
       \/ (main = "Ready" /\ main' = "Retired")
       \/ (main = "Partial" /\ main' = "Retired")
       \/ (main = "Unavailable" /\ main' = "Retired")
       \/ (main = "Queue" /\ main' = "Retired")
       \/ (main = "Record" /\ main' = "Retired")

\* Verify new actor
VerifyNewActor ==
    /\ \/ (main = "Retired" /\ main' = "Reading")

Next == BriefArrives \/ SomeSourcesFail \/ ReadFails \/ Refresh \/ Retry \/ OpenQueue \/ OpenPriority \/ ReturnToBrief \/ ActorChanges \/ VerifyNewActor

Spec == Init /\ [][Next]_vars

====
